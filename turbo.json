{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  },
  "boundaries": {
    "tags": {
      "layer-contracts": {
        "dependencies": {
          "allow": ["layer-toolchain"]
        }
      },
      "layer-sdk": {
        "dependencies": {
          "allow": ["layer-toolchain", "layer-contracts"]
        }
      },
      "layer-storage": {
        "dependencies": {
          "allow": ["layer-toolchain", "layer-contracts"]
        }
      },
      "layer-core": {
        "dependencies": {
          "allow": ["layer-toolchain", "layer-contracts", "layer-storage"]
        }
      },
      "layer-api": {
        "dependencies": {
          "allow": [
            "layer-toolchain",
            "layer-contracts",
            "layer-core",
            "layer-storage"
          ]
        }
      },
      "layer-module": {
        "dependencies": {
          "allow": ["layer-toolchain", "layer-contracts", "layer-sdk"]
        }
      },
      "layer-client": {
        "dependencies": {
          "allow": ["layer-toolchain", "layer-contracts"]
        }
      }
    }
  }
}
