{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "tags": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,32}$"
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "icon": {
      "type": "string",
      "maxLength": 16
    },
    "sdk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "image": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[\\w.\\-/:@]+$"
    },
    "port": {
      "default": 8080,
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "dataPath": {
      "default": "/data",
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "config": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "secret": {
            "default": false,
            "type": "boolean"
          },
          "default": {
            "type": "string"
          }
        },
        "required": ["key", "description"]
      }
    },
    "permissions": {
      "default": {
        "network": "isolated"
      },
      "type": "object",
      "properties": {
        "network": {
          "default": "isolated",
          "type": "string",
          "enum": ["isolated", "outbound"]
        }
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "sdk",
    "image"
  ]
}
